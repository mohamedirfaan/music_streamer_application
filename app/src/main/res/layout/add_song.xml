<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B18">

    <!-- Header -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_new_track"
        android:textColor="#00F5FF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginStart="24dp"
        android:layout_marginTop="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/headerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/expand_your_music_collection"
        android:textColor="#858DAA"
        android:textSize="14sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTitle" />

    <!-- Upload Card -->
    <LinearLayout
        android:id="@+id/uploadCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#12182A"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/headerSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Section title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/track_details"
            android:textColor="#B0B8D0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="16dp" />

        <!-- Song name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Song Name"
            android:textColor="#00F5FF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/songNameInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter song name"
            android:textColor="#FFFFFF"
            android:textColorHint="#69738D"
            android:textSize="15sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:backgroundTint="#00DDEB" />

        <!-- File selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio File"
            android:textColor="#00F5FF"
            android:textSize="14sp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/uploadLayout"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A2238"
            android:visibility="visible"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♫"
                android:textColor="#B66BFF"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your audio track"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MP3 files only"
                android:textColor="#858DAA"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/imageViewLayout"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A2238"
            android:visibility="gone"
            android:padding="12dp">

            <Button
                android:id="@+id/closeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close" />

            <TextView
                android:id="@+id/songNameView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#858DAA"
                android:textSize="12sp"
                android:text="Song name"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- Choose file -->
        <Button
            android:id="@+id/chooseFileButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="BROWSE FILES"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="16dp"
            android:backgroundTint="#7139C6" />

        <!-- Upload -->
        <Button
            android:id="@+id/uploadButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="UPLOAD TRACK  ↑"
            android:textColor="#080B18"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="28dp"
            android:backgroundTint="#00E5EF" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR MUSIC. YOUR UNIVERSE."
        android:textColor="#555F7D"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
